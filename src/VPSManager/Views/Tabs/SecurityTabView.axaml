<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VPSManager.ViewModels"
             xmlns:models="using:VPSManager.Models"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="600"
             x:Class="VPSManager.Views.Tabs.SecurityTabView"
             x:DataType="vm:SecurityTabViewModel">

  <Grid RowDefinitions="*,Auto,Auto" Margin="4,4,4,6">
    
    <!-- KHỐI 1: TỰ ĐỘNG CHẶN IP DÒ MẬT KHẨU (CO GIÃN THEO CHIỀU CAO CỬA SỔ) -->
    <Border Grid.Row="0" Padding="8,6" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Text="Tự Động Chặn IP Dò Mật Khẩu" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" Content="Kích hoạt" IsChecked="{Binding AutoBlockEnabled}" 
                    FontSize="11" FontWeight="SemiBold" Foreground="#2E3338" VerticalAlignment="Center" Margin="0,-4,0,0"/>
        </Grid>
        
        <!-- Dải phân cách -->
        <Separator Grid.Row="1" Height="1" Background="#F1F3F5" Margin="0,0,0,6"/>

        <!-- Dòng 1: Ngưỡng tự động chặn (Giãn đều 2 bên) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="Số lần đăng nhập sai để chặn (5-50):" FontSize="11" Foreground="#5C5E66" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding ThresholdText}" Width="55" Height="26" FontSize="11" 
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Dòng 2: Chặn thủ công -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center" Margin="0,0,0,6">
          <TextBox Grid.Column="0" Text="{Binding ManualIpToBlock}" PlaceholderText="Nhập IP cần chặn thủ công..." 
                   Height="26" FontSize="11" VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="Chặn IP" Command="{Binding ManualBlockIpCommand}" 
                  Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" 
                  Height="26" Padding="12,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Dòng 3: Tiêu đề danh sách IP & nút xóa tất cả -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,4" VerticalAlignment="Center">
          <TextBlock Text="{Binding BlockedCountText}" FontSize="10" FontWeight="SemiBold" Foreground="#5C5E66" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Xóa hết" Command="{Binding UnblockAllIpsCommand}" 
                  IsVisible="{Binding HasBlockedIps}"
                  Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1"
                  FontSize="10" FontWeight="SemiBold" Height="20" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Dòng 4: Khung cuộn danh sách IP bị chặn (Chiếm toàn bộ không gian còn lại và tự động mở rộng theo Height) -->
        <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" MinHeight="45">
          <Panel>
            <!-- Khi danh sách trống -->
            <TextBlock Text="Chưa có IP nào trong danh sách chặn" 
                       IsVisible="{Binding HasNoBlockedIps}"
                       FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Khi có IP bị chặn -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasBlockedIps}">
              <ItemsControl ItemsSource="{Binding BlockedIps}" Margin="4,2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:BlockedIpItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,2" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding IpAddress}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding BlockedAt, StringFormat={}{0:HH:mm dd/MM}}" 
                                 FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0"/>
                      <Button Grid.Column="2" Content="Gỡ" 
                              Command="{Binding $parent[UserControl].((vm:SecurityTabViewModel)DataContext).UnblockIpCommand}"
                              CommandParameter="{Binding}"
                              Background="#EBF5FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                              FontSize="10" FontWeight="SemiBold" Height="20" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>

      </Grid>
    </Border>

    <!-- KHỐI 2: KHÓA TÀI KHOẢN KHI SAI PASS -->
    <Border Grid.Row="1" Padding="8,6" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Khóa Tài Khoản Windows" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
          <TextBlock Text="{Binding AccountLockoutStatusText}" FontSize="10" Foreground="#5C5E66"/>
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ToggleAccountLockoutCommand}"
                Background="#2563EB" Foreground="#FFFFFF"
                Height="26" Width="55" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
          <TextBlock Text="{Binding AccountLockoutButtonText}" FontSize="11" FontWeight="SemiBold"/>
        </Button>
      </Grid>
    </Border>

    <!-- KHỐI 3: CHỈ CHO PHÉP IP TIN CẬY (WHITELIST) -->
    <Border Grid.Row="2" Padding="8,6" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="4">
      <StackPanel Spacing="5">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Chỉ Cho Phép IP Tin Cậy" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding WhitelistStatusSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center"/>
        </Grid>
        <Separator Height="1" Background="#F1F3F5"/>

        <TextBlock Text="Chỉ IP này mới kết nối được RDP (chặn mọi scan ngoài luồng):" FontSize="10" Foreground="#5C5E66"/>

        <TextBox Text="{Binding WhitelistIpText}" PlaceholderText="VD: 14.241.12.34 hoặc 14.241.0.0/16" 
                 Height="26" FontSize="11" VerticalContentAlignment="Center"/>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <Button Grid.Column="0" Content="Áp Dụng Whitelist" Command="{Binding ApplyWhitelistCommand}" 
                  Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" 
                  Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="Mở Lại Mọi IP" Command="{Binding ResetWhitelistCommand}" 
                  Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                  FontWeight="SemiBold" FontSize="11" 
                  Height="26" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
